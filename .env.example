DATABASE_URL=postgresql+psycopg://nutanix:nutanix@db:5432/nutanix_migration
CORS_ORIGINS=http://localhost:5173

NUTANIX_PC_URL=
NUTANIX_USERNAME=
NUTANIX_PASSWORD=
NUTANIX_VERIFY_TLS=true

# Optional service-key RBAC. Keep false for local development.
# When true, set SHA-256 hashes of strong random API keys, never plaintext keys.
AUTH_ENABLED=false
VIEWER_API_KEY_SHA256=
OPERATOR_API_KEY_SHA256=
APPROVER_API_KEY_SHA256=
ADMIN_API_KEY_SHA256=

# Optional local Grafana settings when using the observability profile.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
